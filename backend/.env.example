# Data layer: "memory" runs instantly with no external services, but
# resets on every restart/deploy. "mongo" persists to a real MongoDB (e.g.
# a free MongoDB Atlas cluster) - set MONGO_URI below when using it.
# Routes never depend on which one is active either way (see
# lib/createModel.js).
DB_MODE=memory
MONGO_URI=

PORT=5000
JWT_SECRET=change-this-dev-secret
JWT_EXPIRES_IN=30d

# Email. Leave everything blank to use the built-in console mock.
#
# Preferred: Brevo (brevo.com) over HTTPS - free tier is 300 emails/day and
# only needs EMAIL_FROM verified as a sender on the account (Senders &
# IPs -> Add a sender; no domain needed). Get the key from SMTP & API ->
# API Keys. Use this on Render: its free tier blocks outbound SMTP ports
# entirely, so the SMTP_* option below can never connect from there.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=EasyRide

# Alternative: plain SMTP via nodemailer (only used when BREVO_API_KEY is
# unset). Needs a host that allows outbound SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

STRIPE_SECRET_KEY=

FRONTEND_URL=http://localhost:5173

# Optional: "Sign in with Google" - the OAuth *web client ID* from Google
# Cloud Console (ends in .apps.googleusercontent.com). Same value as the
# frontend's VITE_GOOGLE_CLIENT_ID. Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=

# Simple per-km fare model (NZD), used by utils/distance.js
BASE_FARE=3.5
DEFAULT_RATE_PER_KM=1.8
