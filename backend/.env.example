# Data layer: "memory" runs instantly with no external services.
# A future real-MongoDB mode can be wired in without changing route code,
# since routes only depend on the Model API in lib/MemoryStore.js.
DB_MODE=memory

PORT=5000
JWT_SECRET=change-this-dev-secret
JWT_EXPIRES_IN=7d

# Optional: leave blank to use the built-in mock email/payment services
# (they log to the console instead of calling a real provider).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@taxihub.local

STRIPE_SECRET_KEY=

FRONTEND_URL=http://localhost:5173

# Simple per-km fare model (NZD), used by utils/distance.js
BASE_FARE=3.5
DEFAULT_RATE_PER_KM=1.8
