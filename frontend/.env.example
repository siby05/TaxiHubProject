VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Optional: Stripe test-mode PUBLISHABLE key (starts with pk_test_...).
# Leave blank to keep the mock/auto-paid payment flow. Get it from
# dashboard.stripe.com/test/apikeys - never the secret key here, that one
# only ever goes in the backend's STRIPE_SECRET_KEY env var.
VITE_STRIPE_PUBLISHABLE_KEY=

# Public URL of this site, no trailing slash (e.g. https://easyride.co.nz).
# Used at build time for SEO: canonical and social-preview URLs, sitemap.xml.
VITE_SITE_URL=

# Optional: "Sign in with Google" - the OAuth web client ID from Google
# Cloud Console (ends in .apps.googleusercontent.com). Not a secret - it's
# public by design. Must match the backend's GOOGLE_CLIENT_ID. Leave blank
# to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
