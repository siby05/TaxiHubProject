VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Optional: Stripe test-mode PUBLISHABLE key (starts with pk_test_...).
# Leave blank to keep the mock/auto-paid payment flow. Get it from
# dashboard.stripe.com/test/apikeys - never the secret key here, that one
# only ever goes in the backend's STRIPE_SECRET_KEY env var.
VITE_STRIPE_PUBLISHABLE_KEY=
